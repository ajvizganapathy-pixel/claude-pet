{
  "name": "saber",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop companion for Claude Desktop on Windows.",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "setup": "node scripts/setup.mjs",
    "register": "node scripts/build.mjs && node dist/mcp/register.js",
    "doctor": "node scripts/build.mjs && node dist/mcp/doctor.js",
    "icons": "node scripts/generate-icons.mjs",
    "sprites": "node scripts/generate-sprites.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "koffi": "^3.1.4"
  }
}
